# Port for Express server
PORT=3000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot

# Secret Key for Signing JSON Web Tokens (JWT)
JWT_SECRET=super_secret_careerpilot_jwt_key_2026

# Optional: Google Gemini API Key for AI resume scoring features
GEMINI_API_KEY=your_gemini_api_key_here
